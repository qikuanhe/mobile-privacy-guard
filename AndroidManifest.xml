<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.daweiba.privacyguard"
    android:versionCode="12"
    android:versionName="0.7.1">

    <!-- 列出全部应用（仅侧载分发） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 泄露监控（本地 VPN 只路由 DNS） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Shizuku 可选增强：只有安装了 Shizuku 并授权后才会用到 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ReportActivity" android:exported="false" />

        <activity android:name=".DetailActivity" android:exported="false" />

        <!-- Shizuku 通过此 Provider 把 shell 身份的 Binder 交给本进程 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.daweiba.privacyguard.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <service
            android:name=".LeakMonitorService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="dns_leak_monitor" />
        </service>
    </application>
</manifest>
